generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CITIZEN
  COLLECTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ASSIGNED
  SCHEDULED
  COLLECTOR_ARRIVED
  IN_PROGRESS
  COMPLETED
  COLLECTED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentProvider {
  BKASH
}

enum TransactionStatus {
  INITIATED
  SUCCESS
  FAILED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(CITIZEN)
  status           UserStatus        @default(ACTIVE)
  isDeleted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  citizenProfile   CitizenProfile?
  collectorProfile CollectorProfile?
  auditLogs        AuditLog[]
  invoices         Invoice[]

  feedbacks         Feedback[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model CitizenProfile {
  id             String @id @default(uuid())
  userId         String @unique
  firstName      String
  lastName       String
  phone          String
  defaultAddress String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wasteRequests  WasteRequest[]

  @@map("citizen_profiles")
}

model CollectorProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  firstName   String
  lastName    String
  phone       String
  isAvailable Boolean      @default(true)
  zoneId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceZone ServiceZone  @relation(fields: [zoneId], references: [id])
  assignedRequests WasteRequest[]

  @@map("collector_profiles")
}

model ServiceZone {
  id               String             @id @default(uuid())
  name             String             @unique
  city             String
  isDeleted        Boolean            @default(false)
  collectorProfiles CollectorProfile[]
  wasteRequests    WasteRequest[]

  @@map("service_zones")
}

model WasteCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  description String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wasteRequests WasteRequest[]

  @@map("waste_categories")
}

model WasteRequest {
  id          String        @id @default(uuid())
  citizenId   String
  categoryId  String
  zoneId      String
  address     String
  weight      Float?
  status      RequestStatus @default(PENDING)
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  citizen     CitizenProfile @relation(fields: [citizenId], references: [userId])
  category    WasteCategory  @relation(fields: [categoryId], references: [id])
  zone        ServiceZone    @relation(fields: [zoneId], references: [id])
  
  assignedCollectorId String?
  assignedCollector   CollectorProfile? @relation(fields: [assignedCollectorId], references: [userId])
  collectionSchedule  CollectionSchedule?
  serviceReport       ServiceReport?
  invoice             Invoice?
  feedback            Feedback?

  @@index([status])
  @@index([citizenId])
  @@index([assignedCollectorId])
  @@index([createdAt])
  @@map("waste_requests")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String
  action        String
  entity        String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  actor         User     @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

model CollectionSchedule {
  id            String       @id @default(uuid())
  requestId     String       @unique
  scheduledDate DateTime
  timeWindow    String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  request       WasteRequest @relation(fields: [requestId], references: [id])

  @@index([scheduledDate])
  @@map("collection_schedules")
}

model ServiceReport {
  id            String       @id @default(uuid())
  requestId     String       @unique
  actualWeight  Float
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  request       WasteRequest @relation(fields: [requestId], references: [id])

  @@map("service_reports")
}

model Invoice {
  id          String       @id @default(uuid())
  requestId   String       @unique
  citizenId   String
  amount      Float
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  request     WasteRequest @relation(fields: [requestId], references: [id])
  citizen     User         @relation(fields: [citizenId], references: [id])
  payment     Payment?

  @@index([status])
  @@index([citizenId])
  @@map("invoices")
}

model Payment {
  id            String            @id @default(uuid())
  invoiceId     String            @unique
  amount        Float
  transactionId String?           @unique
  provider      PaymentProvider   @default(BKASH)
  status        TransactionStatus @default(INITIATED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  invoice       Invoice           @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@map("payments")
}

model Feedback {
  id          String       @id @default(uuid())
  citizenId   String
  requestId   String       @unique
  rating      Int
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  citizen     User         @relation(fields: [citizenId], references: [id])
  request     WasteRequest @relation(fields: [requestId], references: [id])

  @@map("feedbacks")
}
